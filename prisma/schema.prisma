generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role   @default(USER)
}

model Game {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  developer   String
  platform    String?
  tags        String[]
  description String?
  imageUrl    String?
}