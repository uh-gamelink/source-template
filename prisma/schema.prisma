generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  role     Role
  profile  Profile?

  sentRequests     Request[] @relation("SentRequests")
  receivedRequests Request[] @relation("ReceivedRequests")

  userGames    UserGame[]
  savedServers UserCommunityServer[]
  reviews      Review[]

  players Player[]
}

model Profile {
  id             Int     @id @default(autoincrement())
  description    String
  interests      String
  profilePicture String?
  username       String? @unique
  userId         Int     @unique
  user           User    @relation(fields: [userId], references: [id])
}

model Game {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  developer   String
  platform    String?
  tags        String[]
  description String?
  imageUrl    String?

  userGames UserGame[]
}

model Player {
  id       Int     @id @default(autoincrement())
  username String
  imageUrl String?
  game     String
  rank     String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  moderationStatus PlayerModerationStatus @default(CLEAN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, game])
}

model CommunityServer {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String
  inviteUrl   String
  tags        String[]
  imageUrl    String?
  featured    Boolean  @default(false)

  savedByUsers UserCommunityServer[]
}

model Request {
  id        Int      @id @default(autoincrement())
  game      String
  rank      String
  notes     String?
  createdAt DateTime @default(now())

  requesterUsername String?
  requesterRank     String?

  status RequestStatus @default(PENDING)

  userId Int
  user   User @relation("SentRequests", fields: [userId], references: [id])

  receiverId Int?
  receiver   User? @relation("ReceivedRequests", fields: [receiverId], references: [id])

  receiverUsername String?
}

model UserGame {
  id      Int      @id @default(autoincrement())
  userId  Int
  gameId  Int
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])
}

model UserCommunityServer {
  id       Int @id @default(autoincrement())
  userId   Int
  serverId Int

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  server CommunityServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
}

enum ReportStatus {
  PENDING
  RESOLVED
  FLAGGED
  BANNED
}

model Report {
  id               Int          @id @default(autoincrement())
  reportedUsername String
  issue            String
  incidentDate     DateTime
  status           ReportStatus @default(PENDING)
  createdAt        DateTime     @default(now())
}

enum PlayerModerationStatus {
  CLEAN
  FLAGGED
  BANNED
}

model Review {
  id        Int      @id @default(autoincrement())
  text      String
  rating    Int
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}